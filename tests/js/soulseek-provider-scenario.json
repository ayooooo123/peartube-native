    },
    "tagged": {
      "file": { "script": "quick", "pad": 128, "tags": [["ALBUM", "Giant Steps"], ["ALBUMARTIST", "John Coltrane"], ["TITLE", "Naima"], ["DATE", "1960"], ["TRACKNUMBER", "6"]] }
    },
