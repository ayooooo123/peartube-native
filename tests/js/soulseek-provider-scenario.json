    "silent": { "file": { "script": "silent" } },
    "slow": { "file": { "script": "waiting" } },
    "stuck": { "file": { "script": "connecting" } },
    "staller": { "file": { "script": "stall", "pad": 1000, "tags": [] } },
    "denier": { "file": { "script": "denied" } },
    "curt": { "file": { "script": "denied-bare" } },
    "failer": { "file": { "script": "upload-failed" } },
    "leaky": { "file": { "script": "secret" } },
    "chatty": { "file": { "script": "chatty", "pad": 2000, "tags": [["ALBUM", "Chat"], ["ARTIST", "Chatty"], ["TRACKNUMBER", "1"], ["TITLE", "Talk"]] } },
    "punctual": { "file": { "script": "connecting-on-the-second" } },
    "ontime": { "file": { "script": "stall-on-the-second", "pad": 1000, "tags": [] } },
    "empty": { "file": { "script": "quick" } }
