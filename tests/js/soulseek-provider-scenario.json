{
  "about": "Sessions for tests/js/soulseek-provider.mjs (the app's plugin) and tests/soulseek_provider.rs (the Rust port). `tick` is the step of the scripted clock in ms; every `at`, `advance` and timeout is a multiple of it. The plugin's watchdog runs on each whole second after a download starts: scripted progress stays off those instants, except in the two `-on-the-second` scripts, where either order of the two gives the same job.",
  "tick": 50,
  "scripts": {
    "normal": [
      { "at": 50, "phase": "queued" },
      { "at": 150, "phase": "queued", "queue": 3 },
      { "at": 1250, "phase": "transferring", "permille": 400 },
      { "at": 2350, "phase": "transferring", "permille": 900 },
      { "at": 3450, "phase": "transferring", "permille": 950 },
      { "at": 3550, "phase": "completed", "permille": 1000 },
      { "at": 3600, "done": true }
    ],
    "quick": [
      { "at": 50, "phase": "transferring", "permille": 500 },
      { "at": 100, "done": true }
    ],
    "silent": [
      { "at": 50, "phase": "queued" }
    ],
    "waiting": [
      { "at": 50, "phase": "queued", "queue": 7 }
    ],
    "connecting": [
      { "at": 50, "phase": "queued", "queue": 0 },
      { "at": 100, "phase": "connecting" }
    ],
    "stall": [
      { "at": 50, "phase": "queued", "queue": 1 },
      { "at": 100, "phase": "transferring", "permille": 100 }
    ],
    "denied": [
      { "at": 50, "phase": "queued" },
      { "at": 100, "error": "upload denied by peer: File not shared..." }
    ],
    "denied-bare": [
      { "at": 50, "error": "Upload Denied By Peer: " }
    ],
    "upload-failed": [
      { "at": 50, "error": "peer failer reported upload failed for @@f\\A - B\\01.flac" }
    ],
    "walled": [
      { "at": 50, "error": "disconnected: peer could not establish indirect connection" }
    ],
    "secret": [
      { "at": 50, "error": "transfer to alice broke: hunter2secret" }
    ],
    "chatty": [
      { "at": 50, "phase": "queued", "queue": 2 },
      { "at": 350, "phase": "queued", "queue": 1 },
      { "at": 750, "phase": "queued", "queue": 0 },
      { "at": 1100, "phase": "queued", "queue": 0 },
      { "at": 1300, "phase": "transferring", "permille": 100 },
      { "at": 2250, "phase": "transferring", "permille": 500 },
      { "at": 2300, "phase": "transferring", "permille": 600 },
      { "at": 2350, "phase": "completed", "permille": 1000 },
      { "at": 2400, "done": true }
    ],
    "connecting-on-the-second": [
      { "at": 50, "phase": "queued", "queue": 0 },
      { "at": 1000, "phase": "connecting" }
    ],
    "stall-on-the-second": [
      { "at": 50, "phase": "queued", "queue": 0 },
      { "at": 1000, "phase": "transferring", "permille": 100 }
    ]
  },
  "search": {
    "coltrane": {
      "hits": [
        { "username": "queued_hires", "slots": true, "queue": 4, "filename": "@@flac\\Album\\01.flac", "size": 40000000, "bitrate": 2304, "sample_rate": 96000, "bit_depth": 24, "length_secs": 240 },
        { "username": "free_cd", "slots": true, "queue": 0, "filename": "@@flac\\Album\\01.flac", "size": 25000000, "bitrate": 1411, "sample_rate": 44100, "bit_depth": 16, "length_secs": 240 },
        { "username": "junk", "slots": true, "queue": 0, "filename": "@@x\\cover.jpg", "size": 5 },
        { "username": "free_hires", "slots": true, "queue": 0, "filename": "@@flac\\Album\\01.flac", "size": 45000000, "bitrate": 2304, "sample_rate": 96000, "bit_depth": 24, "length_secs": 240 },
        { "username": "queued_smaller", "slots": false, "queue": 2, "filename": "@@flac\\Album\\01.flac", "size": 25000000, "bitrate": 1411, "sample_rate": 44100, "bit_depth": 16, "length_secs": 240 },
        { "username": "lossy", "slots": false, "queue": 50, "filename": "@@music\\Lossy\\001.mp3", "size": 5000000, "bitrate": 320, "sample_rate": 44100, "bit_depth": 0, "length_secs": 200 }
      ]
    },
    "boom": { "error": "search exploded for alice with hunter2secret in it" }
  },
