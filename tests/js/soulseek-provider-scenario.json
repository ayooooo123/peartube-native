        "@@m\\Artist\\Album (2001)\\02 - Two.flac": { "script": "quick", "pad": 3000, "tags": [["TRACKNUMBER", "2"], ["TITLE", "Two"], ["ALBUM", "Album"], ["ARTIST", "Artist"], ["DATE", "2001"]] },
        "@@m\\Other\\Second (1999)\\CD1\\01 - Same.flac": { "script": "quick", "pad": 64, "tags": [] },
        "@@m\\Other\\Second (1999)\\CD2\\01 - Same.flac": { "script": "quick", "pad": 65, "tags": [] }
      }
    },
    "pair": {
